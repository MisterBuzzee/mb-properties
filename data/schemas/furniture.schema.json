{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mb-properties/data/furniture.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "model": {
          "description": "Model",
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "price": {
          "description": "Price",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "category": {
          "description": "Category",
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      },
      "required": [
        "label",
        "model",
        "price",
        "category"
      ]
    }
  },
  "additionalProperties": false
}
